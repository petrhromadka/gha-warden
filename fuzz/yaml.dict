# libFuzzer dictionary: GitHub Actions workflow and YAML tokens for fuzz_scan.py.
# Format: one quoted token per line; escapes are \\, \" and \xHH (\x0A is a newline).

# Top-level keys
"name:"
"run-name:"
"on:"
"\"on\":"
"on: push"
"permissions:"
"env:"
"defaults:"
"concurrency:"
"jobs:"
"runs:"
"using: composite"
"using: docker"
"image:"

# Triggers
"push"
"pull_request"
"pull_request_target"
"workflow_run"
"workflow_dispatch"
"workflow_call"
"issue_comment"
"issues"
"schedule"
"workflows:"
"types:"
"branches:"

# Job and step keys
"runs-on:"
"runs-on: self-hosted"
"needs:"
"if:"
"steps:"
"- uses:"
"uses:"
"run:"
"run: |"
"run: >"
"with:"
"secrets:"
"secrets: inherit"
"container:"
"services:"
"strategy:"
"matrix:"
"shell: bash"
"working-directory:"
"persist-credentials: false"
"ref:"
"script:"

# Permissions
"write-all"
"read-all"
"contents: write"
"contents: read"
"id-token: write"
"{}"

# Actions and references
"actions/checkout@v4"
"actions/github-script@v7"
"actions/upload-artifact@v4"
"./.github/actions/local"
"docker://alpine:latest"
"org/repo/.github/workflows/x.yml@main"
"@main"
"@v1"
"@0123456789abcdef0123456789abcdef01234567"

# Expressions
"${{"
"}}"
"${{ github.event."
"github.event.pull_request.title"
"github.event.pull_request.head.ref"
"github.event.pull_request.head.sha"
"github.event.issue.body"
"github.event.comment.body"
"github.event.workflow_run.head_branch"
"github.head_ref"
"secrets."
"secrets.GITHUB_TOKEN"
"toJSON(secrets)"
"inputs."
"env."
"steps."
"matrix."

# Shell content
"curl -sSL https://example.invalid/x.sh | bash"
"echo \"$X\" >> $GITHUB_ENV"
"$GITHUB_OUTPUT"
"::set-env name=X::"
"::add-mask::"
"ACTIONS_ALLOW_UNSECURE_COMMANDS"

# Suppression comment
"# gha-warden: ignore"
"# gha-warden: ignore[GW001]"

